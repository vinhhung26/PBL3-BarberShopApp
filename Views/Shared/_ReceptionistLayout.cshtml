<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
    <title>Thu ngân — BarberMate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root{--gold:#ff9d00;--dark:#1a1a1a;--red:#dc2626;--border:#e2e8f0;}
        *{box-sizing:border-box;}
        body{font-family:'Segoe UI',sans-serif;background:#f0f2f5;height:100vh;overflow:hidden;margin:0;}
        /* NAV */
        .nav{background:var(--dark);height:52px;display:flex;align-items:center;padding:0 18px;gap:8px;border-bottom:2px solid var(--gold);position:sticky;top:0;z-index:200;}
        .nav-brand{font-weight:800;font-size:16px;color:#fff;letter-spacing:1px;margin-right:12px;white-space:nowrap;}
        .nav-brand span{color:var(--gold);}
        /* Bill badge */
        .bill-badge{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;letter-spacing:.5px;text-transform:uppercase;flex-shrink:0;background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0;}
        .bill-badge.drafting{background:#fef3c7;color:#92400e;border-color:#fde68a;}
        .bill-badge.paid{background:#dcfce7;color:#14532d;border-color:#bbf7d0;}
        /* Tabs */
        .nav-tabs-bar{display:flex;gap:2px;margin-left:auto;margin-right:10px;}
        .ntb{background:transparent;border:none;color:rgba(255,255,255,.5);font-size:12px;font-weight:500;padding:5px 12px;border-radius:6px;cursor:pointer;display:flex;align-items:center;gap:5px;transition:.15s;white-space:nowrap;}
        .ntb:hover{background:rgba(255,255,255,.08);color:rgba(255,255,255,.85);}
        .ntb.active{background:rgba(255,157,0,.15);color:var(--gold);}
        .btn-logout{background:transparent;border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);padding:4px 11px;border-radius:6px;font-size:12px;cursor:pointer;text-decoration:none;transition:.2s;}
        .btn-logout:hover{border-color:var(--red);color:#fca5a5;}
        /* Body */
        .pos-body{height:calc(100vh - 52px);overflow:hidden;}
    </style>
</head>
<body>
<nav class="nav">
    <div class="nav-brand">BARBER<span>MATE</span></div>
    <span class="bill-badge" id="G_BADGE">
        <i class="fa-regular fa-circle me-1" style="font-size:8px;"></i>Chưa có hóa đơn
    </span>
    <div class="nav-tabs-bar">
        <button class="ntb active" onclick="switchTab(this,'tab-thungan')">
            <i class="fa-solid fa-cash-register"></i>Thu ngân
        </button>
        <button class="ntb" onclick="switchTab(this,'tab-hoadon')">
            <i class="fa-solid fa-receipt"></i>Hóa đơn
        </button>
        <button class="ntb" onclick="switchTab(this,'tab-lichhen')">
            <i class="fa-regular fa-calendar-days"></i>Lịch hẹn
        </button>
        <button class="ntb" onclick="switchTab(this,'tab-khachhang')">
            <i class="fa-solid fa-users"></i>Khách hàng
        </button>
    </div>
    <a href="/" class="btn-logout"><i class="bi bi-power me-1"></i>Đăng xuất</a>
</nav>
<div class="pos-body">@RenderBody()</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
function switchTab(btn,id){
    document.querySelectorAll('.ntb').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('show','active'));
    const t=document.getElementById(id);
    if(t)t.classList.add('show','active');
}
</script>
@RenderSection("Scripts",required:false)
</body>
</html>

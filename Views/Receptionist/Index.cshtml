</div>


<!-- ═══ TAB KHÁCH HÀNG ═════════════════════════════════════ -->
<div class="tab-pane" id="tab-khachhang">
  <div class="TSW">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
      <div><h5 style="font-weight:800;margin:0;"><i class="fa-solid fa-users me-2" style="color:var(--ok);"></i>Khách hàng</h5><small style="color:var(--mu);">Đăng ký, tra cứu, sửa thông tin</small></div>
      <div style="display:flex;gap:8px;">
        <div class="srch" style="max-width:240px;"><i class="fa-solid fa-magnifying-glass"></i><input id="CU_SRH" placeholder="Tìm tên, SĐT..." oninput="debounceCS(this.value)"></div>
        <button class="btn btn-sm btn-success fw-bold px-3" onclick="openM('modNC')"><i class="fa-solid fa-user-plus me-1"></i>Đăng ký KH</button>
      </div>
    </div>
    <div class="TCARD">
      <table class="TT">
        <thead><tr><th>Khách hàng</th><th>SĐT</th><th>Hạng</th><th style="text-align:center;">Điểm</th><th style="text-align:right;">Tùy chọn</th></tr></thead>
        <tbody id="CU_TB"><tr class="LR"><td colspan="5"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải...</td></tr></tbody>
      </table>
    </div>
  </div>
</div>


@section Scripts {
<script>
// ══════════════════════════════════════════════════════════
// MULTI-DRAFT SYSTEM
// Mỗi draft = { draftId, billId, barberId, items[], custId }
// Cho phép mở nhiều đơn song song, chuyển qua lại tự do.
// ══════════════════════════════════════════════════════════
let drafts     = [];          // mảng draft đang mở
let curDraftId = null;        // draft đang active
let curPay     = null;
let _delTgt    = null;
let _draftSeq  = 0;           // auto-increment local id

const fmt = n => Number(n||0).toLocaleString('vi-VN')+'đ';
const nowISO = () => new Date().toISOString().slice(0,16);

// ── Helpers ───────────────────────────────────────────────
function toast(msg,type='info',ms=3400){
  const c=document.getElementById('TC');
  const ic={success:'fa-circle-check',error:'fa-circle-xmark',info:'fa-circle-info'};
  const cl={success:'TM-s',error:'TM-e',info:'TM-i'};
  const t=document.createElement('div');
  t.className='TM '+cl[type];
  t.innerHTML=`<i class="fa-solid ${ic[type]}"></i>${msg}`;
  c.appendChild(t);
  setTimeout(()=>{t.style.animation='tout .28s ease forwards';setTimeout(()=>t.remove(),280);},ms);
}

async function api(url,opts={}){
  const r=await fetch(url,{headers:{'Content-Type':'application/json',...(opts.headers||{})},...opts});
  const d=await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(d.message||'HTTP '+r.status);
  return d;
}

function openM(id){document.getElementById(id).classList.add('open');}
function closeM(id){document.getElementById(id).classList.remove('open');}

function curDraft(){return drafts.find(d=>d.id===curDraftId)||null;}

// ══ INIT ══════════════════════════════════════════════════
async function initPage(){
  await Promise.all([loadBarbers(),loadMenu()]);
  newDraft(); // Bắt đầu với 1 đơn trắng
}

// ══ BARBERS ═══════════════════════════════════════════════
let allBarbers=[];
async function loadBarbers(){
  try{
    allBarbers=await api('/api/barbers');
    fillBarberSel(document.getElementById('B_BAR'));
    fillBarberSel(document.getElementById('aBarberId'));
  }catch(e){toast('Không tải barber: '+e.message,'error');}
}

function fillBarberSel(sel){
  if(!sel)return;
  const prev=sel.value;
  sel.innerHTML='<option value="">-- Chọn Barber --</option>';
  allBarbers.forEach(b=>{
    const busy=b.status==='BUSY';
    const o=new Option(`${busy?'🔴':'✅'} ${b.fullName} (${busy?'Đang bận':'Đang rảnh'})`,b.barberId);
    if(busy)o.disabled=true;
    sel.add(o);
  });
  if(prev)sel.value=prev;
}

// ══ MENU ══════════════════════════════════════════════════
const SICO={'Cắt tóc nam':'fa-scissors','Combo Cắt Gội':'fa-shower','Uốn tóc':'fa-wind','Nhuộm tóc':'fa-palette','Cạo mặt':'fa-user-tie','Gội đầu':'fa-droplet'};

async function loadMenu(){
  const g=document.getElementById('SG');
  const [sr,pr]=await Promise.allSettled([api('/api/services'),api('/api/products')]);
  const svcs=sr.status==='fulfilled'?sr.value:[
    {serviceId:1,serviceName:'Cắt tóc nam',price:100000},{serviceId:2,serviceName:'Combo Cắt Gội',price:150000},
    {serviceId:3,serviceName:'Uốn tóc',price:300000},{serviceId:4,serviceName:'Nhuộm tóc',price:350000},
    {serviceId:5,serviceName:'Cạo mặt',price:80000},{serviceId:6,serviceName:'Gội đầu',price:60000},
  ];
  const prds=pr.status==='fulfilled'?pr.value:[
    {productId:1,productName:'Sáp Volcanic Clay',price:250000},
    {productId:2,productName:'Gôm xịt tóc',price:120000},
    {productId:3,productName:'Dầu gội Argan',price:180000},
  ];
  g.innerHTML='';
  svcs.forEach(s=>g.appendChild(mkCard('service','svc_'+s.serviceId,s.serviceName,s.price,s.serviceId,null)));
  prds.forEach(p=>g.appendChild(mkCard('product','prd_'+p.productId,p.productName,p.price,null,p.productId)));
}

function mkCard(type,uid,name,price,sid,pid){
  const c=document.createElement('div');
  c.className='sc';c.id='card_'+uid;
  c.dataset.cat=type;c.dataset.name=name;c.dataset.price=price;
  c.dataset.type=type;c.dataset.sid=sid||'';c.dataset.pid=pid||'';
  const ico=type==='service'
    ?`<div class="si"><i class="fa-solid ${SICO[name]||'fa-scissors'}"></i></div>`
    :`<div class="si" style="background:#f0fdf4;color:#15803d;"><i class="fa-solid fa-jar"></i></div>`;
  c.innerHTML=`${ico}<div class="sn">${name}</div><div class="sp">${fmt(price)}</div>`;
  c.onclick=()=>addItem(c);
  return c;
}

// ══ DRAFT MANAGEMENT ══════════════════════════════════════
function newDraft(){
  const d={
    id: ++_draftSeq,
    billId: null,
    barberId: null,
    items: [],       // {uid,name,type,sid,pid,price,qty}
    custId: null,
    custName: '',
  };
  drafts.push(d);
  switchDraft(d.id);
  renderQueueBar();
  toast('Đơn mới #D'+d.id+' đã được tạo','info',1500);
}

function switchDraft(id){
  curDraftId=id;
  curPay=null;
  const d=curDraft();
  if(!d)return;

  // Restore barber select
  const bsel=document.getElementById('B_BAR');
  bsel.value=d.barberId||'';

  // Restore customer
  document.getElementById('C_PHONE').value=d.custPhone||'';
  document.getElementById('C_CUSTID').value=d.custId||'';
  const cf=document.getElementById('C_FOUND');
  if(d.custName){
    document.getElementById('CF_NAME').textContent=d.custName;
    document.getElementById('CF_TIER').textContent='';
    cf.classList.add('show');
  }else{cf.classList.remove('show');}

  // Restore payment method
  document.querySelectorAll('.pmb').forEach(b=>b.classList.remove('on'));
  document.getElementById('C_PREV').classList.remove('show');

  // Highlight card states
  syncCardHighlight();

  renderBill();
  renderQueueBar();
  updateBadge();
}

function removeDraft(id){
  const idx=drafts.findIndex(d=>d.id===id);
  if(idx<0)return;
  const d=drafts[idx];
  // Nếu có billId chưa PAY thì không xóa ngay (để trong DS hóa đơn)
  drafts.splice(idx,1);
  if(curDraftId===id){
    curDraftId=drafts.length?drafts[Math.max(0,idx-1)].id:null;
    if(curDraftId)switchDraft(curDraftId);
    else{
      // Không còn draft nào → reset UI
      resetUI();
    }
  }
  renderQueueBar();
  updateBadge();
}

function resetUI(){
  document.getElementById('B_BAR').value='';
  document.getElementById('B_IDL').textContent='';
  document.getElementById('B_STATUS').textContent='';
  document.getElementById('C_PHONE').value='';
  document.getElementById('C_CUSTID').value='';
  document.getElementById('C_FOUND').classList.remove('show');
  document.querySelectorAll('.pmb').forEach(b=>b.classList.remove('on'));
  document.getElementById('C_PREV').classList.remove('show');
  document.querySelectorAll('.sc').forEach(c=>c.classList.remove('on'));
  document.getElementById('B_ITEMS').innerHTML='';
  document.getElementById('B_ITEMS').appendChild(document.getElementById('B_EMPTY'));
  document.getElementById('B_EMPTY').style.display='flex';
  calcTotal([]);
  updBtns();
}

function renderQueueBar(){
  const bar=document.getElementById('QB');
  const newBtn=bar.querySelector('.q-new');
  bar.innerHTML='';
  drafts.forEach(d=>{
    const tab=document.createElement('button');
    tab.className='q-tab'+(d.id===curDraftId?' on':'');
    const tot=d.items.reduce((s,x)=>s+x.price*x.qty,0);
    const lbl=d.billId?`#${d.billId}`:`Đơn ${d.id}`;
    tab.innerHTML=`<i class="fa-solid fa-file-invoice" style="font-size:10px;"></i>${lbl} ${tot>0?'· '+fmt(tot):''}<span class="qx" onclick="event.stopPropagation();removeDraft(${d.id})">✕</span>`;
    tab.onclick=()=>switchDraft(d.id);
    bar.appendChild(tab);
  });
  bar.appendChild(newBtn||createNewBtn());
}

function createNewBtn(){
  const b=document.createElement('button');
  b.className='q-new';b.innerHTML='<i class="fa-solid fa-plus me-1"></i>Đơn mới';
  b.onclick=newDraft;return b;
}

function syncCardHighlight(){
  const d=curDraft();
  const inBill=new Set(d?(d.items.map(x=>x.uid)):[]);
  document.querySelectorAll('.sc').forEach(c=>{
    const uid=c.id.replace('card_','');
    c.classList.toggle('on',inBill.has(uid));
  });
}

// ══ BARBER CHANGE ════════════════════════════════════════
async function onBarberChange(){
  const d=curDraft();if(!d)return;
  const v=parseInt(document.getElementById('B_BAR').value);
  if(!v){d.barberId=null;return;}

  // Nếu draft đã có items và đổi barber → xác nhận
  if(d.billId&&d.items.length>0){
    if(!confirm('Đổi barber sẽ xóa các dịch vụ trong đơn này (sản phẩm vẫn giữ). Tiếp tục?')){
      document.getElementById('B_BAR').value=d.barberId||'';return;
    }
    // Xóa service items khỏi local (sản phẩm giữ lại)
    d.items=d.items.filter(x=>x.type==='product');
  }

  d.barberId=v;

  // Nếu chưa có billId → tạo bill mới trên server
  if(!d.billId){
    try{
      const cid=parseInt(document.getElementById('C_CUSTID').value)||null;
      const r=await api('/api/orders',{method:'POST',body:JSON.stringify({barberId:v,customerId:cid})});
      d.billId=r.billId;
      document.getElementById('B_IDL').textContent='#'+d.billId;
      toast('Đơn #'+d.billId+' · Barber: '+r.barberName,'success',2000);
    }catch(e){
      toast('Không tạo bill: '+e.message,'error');
      document.getElementById('B_BAR').value='';d.barberId=null;return;
    }
  }

  renderBill();renderQueueBar();updateBadge();
}

// ══ ADD ITEM ══════════════════════════════════════════════
async function addItem(card){
  const d=curDraft();if(!d){toast('Không có đơn nào đang mở','error');return;}
  if(!d.billId){toast('Vui lòng chọn Barber trước!','error');return;}

  const type=card.dataset.type,name=card.dataset.name,price=parseInt(card.dataset.price);
  const sid=card.dataset.sid?parseInt(card.dataset.sid):null;
  const pid=card.dataset.pid?parseInt(card.dataset.pid):null;
  const uid=card.id.replace('card_','');
  const ex=d.items.find(x=>x.uid===uid);

  if(ex&&type==='service'){toast('"'+name+'" đã có trong đơn','info',2000);return;}

  const body=type==='service'
    ?{type:'service',serviceId:sid,barberId:d.barberId}
    :{type:'product',productId:pid,quantity:1};

  try{
    await api('/api/orders/'+d.billId+'/items',{method:'POST',body:JSON.stringify(body)});
    if(ex&&type==='product'){ex.qty++;}
    else{d.items.push({uid,name,type,sid,pid,price,qty:1});}
    card.classList.add('on','pop');
    setTimeout(()=>card.classList.remove('pop'),200);
    renderBill();renderQueueBar();updateBadge();
    toast('"'+name+'" thêm vào đơn #'+d.billId,'success',1500);
  }catch(e){toast(e.message,'error');}
}

// ══ RENDER BILL ═══════════════════════════════════════════
function renderBill(){
  const d=curDraft();
  const items=d?d.items:[];
  const w=document.getElementById('B_ITEMS'),e=document.getElementById('B_EMPTY');

  document.getElementById('B_IDL').textContent=d&&d.billId?'#'+d.billId:'';
  document.getElementById('B_STATUS').textContent=d&&d.billId?'PENDING':'';

  if(!items.length){
    w.innerHTML='';w.appendChild(e);e.style.display='flex';
    calcTotal([]);updBtns();return;
  }
  e.style.display='none';
  w.innerHTML=items.map(it=>`
    <div class="brow">
      <div class="bri">
        <div class="rn">${it.name}</div>
        <span class="tb ${it.type==='service'?'ts':'tp'}">${it.type==='service'?'Dịch vụ':'Sản phẩm'}</span>
      </div>
      ${it.type==='product'?`<div class="qb"><button class="qbtn" onclick="chgQty('${it.uid}',-1)">−</button><span class="qv">${it.qty}</span><button class="qbtn" onclick="chgQty('${it.uid}',1)">+</button></div>`:'<div style="width:64px;"></div>'}
      <div class="rp">${fmt(it.price*it.qty)}</div>
      <button class="dbtn" onclick="askDel('${it.uid}','${it.name.replace(/'/g,"\\'")}')"><i class="fa-solid fa-trash-can"></i></button>
    </div>`).join('');
  calcTotal(items);updBtns();
}

async function chgQty(uid,delta){
  const d=curDraft();if(!d)return;
  const it=d.items.find(x=>x.uid===uid);if(!it)return;
  const nq=it.qty+delta;
  if(nq<=0){askDel(uid,it.name);return;}
  if(delta>0&&d.billId){
    try{await api('/api/orders/'+d.billId+'/items',{method:'POST',body:JSON.stringify({type:'product',productId:it.pid,quantity:1})});}
    catch(e){toast(e.message,'error');return;}
  }
  it.qty=nq;renderBill();renderQueueBar();
}

function askDel(uid,name){
  _delTgt=uid;
  document.getElementById('modDelMsg').textContent='Xóa "'+name+'" khỏi đơn?';
  document.getElementById('modDelOk').onclick=doDel;
  openM('modDel');
}
function doDel(){
  const d=curDraft();if(!d)return;
  const it=d.items.find(x=>x.uid===_delTgt);
  if(it){const c=document.getElementById('card_'+_delTgt);if(c)c.classList.remove('on');}
  d.items=d.items.filter(x=>x.uid!==_delTgt);
  closeM('modDel');renderBill();renderQueueBar();
  toast('Đã xóa khỏi đơn','info',1500);
}

function calcTotal(items){
  const tot=items.reduce((s,x)=>s+x.price*x.qty,0);
  const cnt=items.reduce((s,x)=>s+x.qty,0);
  document.getElementById('B_TOT').textContent=fmt(tot);
  document.getElementById('B_SUB').textContent=fmt(tot);
  document.getElementById('B_CNT').textContent=cnt;
  if(curPay)document.getElementById('C_PAMT').textContent=fmt(tot);
}

function updBtns(){
  const d=curDraft();
  const hasItems=d&&d.items.length>0&&d.billId;
  document.getElementById('BTN_SAVE').disabled=!hasItems;
  document.getElementById('BTN_PAY').disabled=!(hasItems&&curPay);
}

// ══ LƯU ĐƠN (PENDING) → chuyển sang đơn trắng mới ═══════
async function saveDraft(){
  const d=curDraft();if(!d||!d.billId)return;
  // Bill đã được tạo và items đã push lên server → chỉ cần đánh dấu local
  toast('Đơn #'+d.billId+' đã lưu! Chuyển sang đơn mới.','success',2500);
  // Reload barbers (barber vẫn BUSY cho đến khi thanh toán)
  await loadBarbers();
  // Tạo đơn mới trắng tự động
  newDraft();
}

// ══ THANH TOÁN NGAY ══════════════════════════════════════
async function doPay(){
  const d=curDraft();if(!d||!d.billId)return;
  const btn=document.getElementById('BTN_PAY');
  btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin me-2"></i>Đang xử lý...';
  try{
    await api('/api/orders/'+d.billId+'/pay',{method:'PUT'});
    const tot=d.items.reduce((s,x)=>s+x.price*x.qty,0);
    const ml={cash:'Tiền mặt',transfer:'Chuyển khoản',card:'Thẻ'}[curPay];
    toast('✅ Đơn #'+d.billId+' đã thanh toán! '+fmt(tot)+' · '+ml,'success',5000);
    // Xóa draft này khỏi queue
    drafts=drafts.filter(x=>x.id!==d.id);
    document.querySelectorAll('.sc').forEach(c=>c.classList.remove('on'));
    await loadBarbers();
    if(drafts.length){switchDraft(drafts[drafts.length-1].id);}
    else{curDraftId=null;resetUI();}
    renderQueueBar();updateBadge();
  }catch(e){
    toast('Lỗi thanh toán: '+e.message,'error');
    btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-check-circle"></i>Thanh toán';
    updBtns();
  }
}

// ══ PHƯƠNG THỨC THANH TOÁN ════════════════════════════════
function selPay(btn){
  document.querySelectorAll('.pmb').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');curPay=btn.dataset.m;
  const lbl={cash:'Thu tiền mặt',transfer:'Thu chuyển khoản',card:'Thu qua thẻ'}[curPay];
  const d=curDraft();
  const tot=d?d.items.reduce((s,x)=>s+x.price*x.qty,0):0;
  document.getElementById('C_PLBL').textContent=lbl;
  document.getElementById('C_PAMT').textContent=fmt(tot);
  document.getElementById('C_PREV').classList.add('show');
  updBtns();
}

// ══ BADGE ═════════════════════════════════════════════════
function updateBadge(){
  const b=document.getElementById('G_BADGE');if(!b)return;
  const hasDrafts=drafts.some(d=>d.billId&&d.items.length>0);
  if(hasDrafts){
    b.className='bill-badge drafting';
    b.innerHTML='<i class="fa-solid fa-circle-dot me-1" style="font-size:8px;"></i>Đang lập hóa đơn ('+drafts.filter(d=>d.billId).length+')';
  }else{
    b.className='bill-badge';
    b.style='';
    b.innerHTML='<i class="fa-regular fa-circle me-1" style="font-size:8px;"></i>Chưa có hóa đơn';
  }
}

// ══ CUSTOMER LOOKUP ══════════════════════════════════════
let _clt=null;
function debounceCL(v){
  clearTimeout(_clt);
  const d=curDraft();
  const f=document.getElementById('C_FOUND');
  if(v.length<4){f.classList.remove('show');if(d)d.custId=null;document.getElementById('C_CUSTID').value='';return;}
  _clt=setTimeout(async()=>{
    try{
      const l=await api('/api/customers?search='+encodeURIComponent(v));
      const d=curDraft();
      if(l.length){
        document.getElementById('CF_NAME').textContent=l[0].fullName+' — '+l[0].phone;
        document.getElementById('CF_TIER').textContent='Hạng: '+(l[0].customerTier||'Thành viên')+' · Điểm: '+(l[0].rewardPoints||0);
        document.getElementById('C_CUSTID').value=l[0].customerId;
        if(d){d.custId=l[0].customerId;d.custName=l[0].fullName+' — '+l[0].phone;d.custPhone=v;}
      }else{
        document.getElementById('CF_NAME').textContent='Không tìm thấy khách hàng';
        document.getElementById('CF_TIER').textContent='';
        document.getElementById('C_CUSTID').value='';
        if(d){d.custId=null;d.custName='';d.custPhone=v;}
      }
      f.classList.add('show');
    }catch{}
  },450);
}

// ══ FILTER MENU ══════════════════════════════════════════
function filterCat(pill,cat){
  document.querySelectorAll('.pill').forEach(p=>p.classList.remove('on'));pill.classList.add('on');
  document.querySelectorAll('.sc').forEach(c=>c.style.display=(cat==='all'||c.dataset.cat===cat)?'':'none');
}
function filterSearch(q){
  const lo=q.toLowerCase();
  document.querySelectorAll('.sc').forEach(c=>c.style.display=c.dataset.name.toLowerCase().includes(lo)?'':'none');
}

// ══ TAB: HÓA ĐƠN ═════════════════════════════════════════
async function loadBills(){
  const tb=document.getElementById('BL_TB');
  const st=document.getElementById('BL_ST').value;
  const dt=document.getElementById('BL_DT').value;
  tb.innerHTML='<tr class="LR"><td colspan="7"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải...</td></tr>';
  try{
    let list=await api('/api/orders');
    if(st)list=list.filter(b=>b.status===st);
    if(dt)list=list.filter(b=>b.createDate&&b.createDate.startsWith(dt));
    if(!list.length){tb.innerHTML='<tr class="LR"><td colspan="7">Không có hóa đơn nào.</td></tr>';return;}
    tb.innerHTML=list.map(b=>{
      const sc=b.status==='PAID'?'spa':'spd',lb=b.status==='PAID'?'Đã thanh toán':'Chờ thanh toán';
      const dt2=b.createDate?new Date(b.createDate).toLocaleString('vi-VN'):'—';
      return `<tr>
        <td><b>#${b.billId}</b></td>
        <td>${b.customerName||'Khách lẻ'}</td>
        <td>${b.barberName||'—'}</td>
        <td style="font-weight:700;color:var(--ok);">${fmt(b.totalAmount)}</td>
        <td><span class="ST ${sc}">${lb}</span></td>
        <td style="font-size:11px;color:var(--mu);">${dt2}</td>
        <td style="text-align:right;">
          <button class="btn btn-sm btn-light text-primary rounded-circle me-1" onclick="viewBill(${b.billId})"><i class="fa-solid fa-eye"></i></button>
          ${b.status!=='PAID'?`<button class="btn btn-sm btn-success fw-bold rounded-pill px-2" onclick="payBillDirect(${b.billId})"><i class="fa-solid fa-check me-1"></i>TT ngay</button>`:''}
        </td>
      </tr>`;
    }).join('');
  }catch(e){tb.innerHTML='<tr class="LR"><td colspan="7">Lỗi: '+e.message+'</td></tr>';}
}

async function viewBill(id){
  try{
    const b=await api('/api/orders/'+id);
    document.getElementById('bdId').textContent='#'+b.billId;
    const sR=(b.services||[]).map(s=>`<tr><td>${s.serviceName}</td><td>${s.barberName||'—'}</td><td style="font-weight:700;">${fmt(s.price)}</td></tr>`).join('');
    const pR=(b.products||[]).map(p=>`<tr><td>${p.productName} ×${p.quantity}</td><td>—</td><td style="font-weight:700;">${fmt((p.price||0)*(p.quantity||1))}</td></tr>`).join('');
    const sc=b.status==='PAID'?'spa':'spd',lb=b.status==='PAID'?'Đã TT':'Chờ TT';
    document.getElementById('bdBody').innerHTML=`
      <div style="margin-bottom:10px;font-size:11px;color:var(--mu);">
        Khách: <b>${b.customer?.fullName||'Khách lẻ'}</b> &nbsp;·&nbsp;
        Ngày: <b>${b.createDate?new Date(b.createDate).toLocaleString('vi-VN'):'—'}</b> &nbsp;·&nbsp;
        TT: <span class="ST ${sc}">${lb}</span>
      </div>
      <table class="TT" style="margin-bottom:8px;">
        <thead><tr><th>Tên</th><th>Barber</th><th>Giá</th></tr></thead>
        <tbody>${sR+pR||'<tr><td colspan="3" style="color:var(--mu);text-align:center;">Chưa có mục</td></tr>'}</tbody>
      </table>
      <div style="text-align:right;font-size:16px;font-weight:800;color:var(--ok);">Tổng: ${fmt(b.totalAmount)}</div>`;
    document.getElementById('bdActs').innerHTML=`
      <button class="bmc" style="flex:1;" onclick="closeM('modBD')">Đóng</button>
      ${b.status!=='PAID'?`<button class="bms" style="flex:1.5;" onclick="payBillDirect(${b.billId});closeM('modBD');"><i class="fa-solid fa-check me-1"></i>Thanh toán ngay</button>`:''}`;
    openM('modBD');
  }catch(e){toast('Lỗi: '+e.message,'error');}
}

async function payBillDirect(id){
  if(!confirm('Xác nhận thanh toán hóa đơn #'+id+'?'))return;
  try{
    await api('/api/orders/'+id+'/pay',{method:'PUT'});
    toast('Đơn #'+id+' đã thanh toán!','success');
    loadBills();loadBarbers();
    // Refresh barber select
    fillBarberSel(document.getElementById('B_BAR'));
  }catch(e){toast(e.message,'error');}
}

// ══ TAB: LỊCH HẸN ════════════════════════════════════════
async function loadAppts(){
  const dt=document.getElementById('AP_DT').value;
  const tb=document.getElementById('AP_TB');
  tb.innerHTML='<tr class="LR"><td colspan="5"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải...</td></tr>';
  try{
    const list=await api('/api/appointments?date='+dt);
    if(!list.length){tb.innerHTML='<tr class="LR"><td colspan="5">Không có lịch hẹn.</td></tr>';return;}
    const SC={'Chờ xử lý':'sw','Đã xác nhận':'sc','Hoàn thành':'sd','Đã huỷ':'sx'};
    tb.innerHTML=list.map(a=>{
      const time=new Date(a.appointmentTime).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'});
      const sc=SC[a.status]||'sw';
      const canC=a.status==='Chờ xử lý',canX=a.status!=='Hoàn thành'&&a.status!=='Đã huỷ';
      return `<tr>
        <td><span class="badge bg-dark rounded-pill px-2">${time}</span></td>
        <td><b>${a.customer?.fullName||'Khách lẻ'}</b><br><small style="color:var(--mu);">${a.customer?.phone||'—'}</small></td>
        <td>${a.barber?.fullName||'—'}</td>
        <td><span class="ST ${sc}">${a.status}</span></td>
        <td style="text-align:right;">
          ${canC?`<button class="btn btn-sm btn-success fw-bold rounded-pill px-2 me-1" onclick="updAppt(${a.appointmentId},'Đã xác nhận')"><i class="fa-solid fa-check me-1"></i>Xác nhận</button>`:''}
          ${canX?`<button class="btn btn-sm btn-light text-danger rounded-circle" onclick="updAppt(${a.appointmentId},'Đã huỷ')"><i class="fa-solid fa-xmark"></i></button>`:''}
        </td>
      </tr>`;
    }).join('');
  }catch(e){tb.innerHTML='<tr class="LR"><td colspan="5">Lỗi: '+e.message+'</td></tr>';}
}

async function updAppt(id,st){
  try{await api('/api/appointments/'+id+'/status',{method:'PUT',body:JSON.stringify({status:st})});toast('Cập nhật: '+st,'success');loadAppts();}
  catch(e){toast(e.message,'error');}
}

function resetApptDate(){document.getElementById('AP_DT').value=new Date().toISOString().split('T')[0];loadAppts();}

let _aptT=null;
function openApptModal(){
  const dt=new Date(Date.now()+3600000);dt.setMinutes(0,0,0);
  document.getElementById('aTime').value=dt.toISOString().slice(0,16);
  document.getElementById('aPhone').value='';
  document.getElementById('aHint').textContent='';document.getElementById('aHint').className='mhint';
  document.getElementById('aCustId').value='';
  fillBarberSel(document.getElementById('aBarberId'));
  openM('modAppt');
}
document.getElementById('aPhone').addEventListener('input',function(){
  clearTimeout(_aptT);const v=this.value,h=document.getElementById('aHint');
  document.getElementById('aCustId').value='';
  if(v.length<4){h.textContent='';return;}
  _aptT=setTimeout(async()=>{
    try{
      const l=await api('/api/customers?search='+encodeURIComponent(v));
      if(l.length){h.textContent='✅ '+l[0].fullName+' ('+l[0].customerTier+')';h.className='mhint ok';document.getElementById('aCustId').value=l[0].customerId;}
      else{h.textContent='⚠️ Không tìm thấy — cần đăng ký KH mới';h.className='mhint bad';}
    }catch{}
  },450);
});
async function submitAppt(){
  const cid=parseInt(document.getElementById('aCustId').value);
  const bid=parseInt(document.getElementById('aBarberId').value);
  const t=document.getElementById('aTime').value;
  if(!cid){toast('Nhập SĐT hợp lệ (cần đăng ký KH trước)','error');return;}
  if(!bid){toast('Chọn barber','error');return;}
  if(!t){toast('Chọn thời gian','error');return;}
  const btn=document.getElementById('btnApptOk');btn.disabled=true;
  try{
    await api('/api/appointments',{method:'POST',body:JSON.stringify({customerId:cid,barberId:bid,appointmentTime:new Date(t).toISOString()})});
    toast('Tạo lịch hẹn thành công!','success');closeM('modAppt');loadAppts();
  }catch(e){toast('Lỗi: '+e.message,'error');}
  finally{btn.disabled=false;}
}

// ══ TAB: KHÁCH HÀNG ══════════════════════════════════════
let _cst=null;
function debounceCS(v){clearTimeout(_cst);_cst=setTimeout(()=>loadCusts(v),400);}

async function loadCusts(s=''){
  const tb=document.getElementById('CU_TB');
  tb.innerHTML='<tr class="LR"><td colspan="5"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải...</td></tr>';
  try{
    const list=await api(s?'/api/customers?search='+encodeURIComponent(s):'/api/customers');
    if(!list.length){tb.innerHTML='<tr class="LR"><td colspan="5">Không tìm thấy khách hàng.</td></tr>';return;}
    const TC={'Thành viên':'#f1f5f9','Bạc':'#e2e8f0','Vàng':'#fef3c7','Kim cương':'#dbeafe'};
    const TT={'Thành viên':'#475569','Bạc':'#334155','Vàng':'#92400e','Kim cương':'#1e3a8a'};
    tb.innerHTML=list.map(c=>`
      <tr>
        <td><b>${c.fullName||'—'}</b><br><small style="color:var(--mu);">#KH${String(c.customerId).padStart(3,'0')}</small></td>
        <td>${c.phone}</td>
        <td><span class="ST" style="background:${TC[c.customerTier]||'#f1f5f9'};color:${TT[c.customerTier]||'#475569'};">${c.customerTier||'Thành viên'}</span></td>
        <td style="text-align:center;"><span class="badge bg-warning text-dark">${c.rewardPoints||0}</span></td>
        <td style="text-align:right;">
          <button class="btn btn-sm btn-light text-primary rounded-circle me-1" title="Lịch sử" onclick="custHist(${c.customerId},'${(c.fullName||'').replace(/'/g,"\\'")}')"><i class="fa-solid fa-clock-rotate-left"></i></button>
          <button class="btn btn-sm btn-light text-dark rounded-circle" title="Sửa" onclick="openEC(${c.customerId},'${(c.fullName||'').replace(/'/g,"\\'")}','${c.phone}','${c.dateOfBirth||''}')"><i class="fa-solid fa-pen"></i></button>
        </td>
      </tr>`).join('');
  }catch(e){tb.innerHTML='<tr class="LR"><td colspan="5">Lỗi: '+e.message+'</td></tr>';}
}

async function custHist(id,name){
  try{
    const d=await api('/api/customers/'+id);
    const bills=d.bills||[];
    if(!bills.length){toast(name+' chưa có giao dịch','info');return;}
    const rows=bills.slice(0,5).map(b=>`<tr><td>#${b.billId}</td><td>${fmt(b.totalAmount)}</td><td><span class="ST ${b.status==='PAID'?'spa':'spd'}">${b.status}</span></td><td style="font-size:10px;color:var(--mu);">${b.createDate?new Date(b.createDate).toLocaleDateString('vi-VN'):'—'}</td></tr>`).join('');
    document.getElementById('bdId').textContent='— Lịch sử: '+name;
    document.getElementById('bdBody').innerHTML='<table class="TT"><thead><tr><th>#HĐ</th><th>Tổng</th><th>TT</th><th>Ngày</th></tr></thead><tbody>'+rows+'</tbody></table>';
    document.getElementById('bdActs').innerHTML='<button class="bms" style="width:100%;" onclick="closeM(\'modBD\')">Đóng</button>';
    openM('modBD');
  }catch(e){toast(e.message,'error');}
}

async function submitNC(){
  const name=document.getElementById('ncName').value.trim();
  const phone=document.getElementById('ncPhone').value.trim();
  const dob=document.getElementById('ncDob').value||null;
  if(!name){toast('Nhập tên khách hàng','error');return;}
  if(!phone){toast('Nhập số điện thoại','error');return;}
  const btn=document.getElementById('btnNCOk');btn.disabled=true;
  try{
    await api('/api/customers',{method:'POST',body:JSON.stringify({fullName:name,phone,dateOfBirth:dob})});
    toast('Đã đăng ký '+name+'!','success');
    closeM('modNC');
    ['ncName','ncPhone','ncDob'].forEach(id=>document.getElementById(id).value='');
    loadCusts();
  }catch(e){toast('Lỗi: '+e.message,'error');}
  finally{btn.disabled=false;}
}

function openEC(id,name,phone,dob){
  document.getElementById('ecId').value=id;
  document.getElementById('ecName').value=name;
  document.getElementById('ecPhone').value=phone;
  document.getElementById('ecDob').value=dob||'';
  openM('modEC');
}
async function submitEC(){
  const id=document.getElementById('ecId').value;
  const body={fullName:document.getElementById('ecName').value.trim(),phone:document.getElementById('ecPhone').value.trim()};
  const dob=document.getElementById('ecDob').value;if(dob)body.dateOfBirth=dob;
  const btn=document.getElementById('btnECOk');btn.disabled=true;
  try{
    await api('/api/customers/'+id,{method:'PUT',body:JSON.stringify(body)});
    toast('Đã cập nhật!','success');closeM('modEC');loadCusts();
  }catch(e){toast('Lỗi: '+e.message,'error');}
  finally{btn.disabled=false;}
}

// ══ TAB SWITCHING ════════════════════════════════════════
const _orig=window.switchTab;
window.switchTab=function(btn,id){
  _orig(btn,id);
  if(id==='tab-lichhen')loadAppts();
  if(id==='tab-khachhang')loadCusts();
  if(id==='tab-hoadon')loadBills();
};


  </div>
</div>


<!-- ═══ TAB LỊCH HẸN ═══════════════════════════════════════ -->
<div class="tab-pane" id="tab-lichhen">
  <div class="TSW">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
      <div><h5 style="font-weight:800;margin:0;"><i class="fa-regular fa-calendar-days me-2" style="color:var(--inf);"></i>Quản lý Lịch hẹn</h5><small style="color:var(--mu);">Kiểm soát lịch khách đặt</small></div>
      <div style="display:flex;gap:8px;align-items:center;">
        <input type="date" id="AP_DT" style="padding:6px 10px;border:1.5px solid var(--bd);border-radius:7px;font-size:12px;outline:none;width:148px;" value="@DateTime.Now.ToString("yyyy-MM-dd")" onchange="loadAppts()">
        <button class="btn btn-sm btn-dark px-3" onclick="resetApptDate()">Hôm nay</button>
        <button class="btn btn-sm btn-warning fw-bold text-dark" onclick="openApptModal()"><i class="fa-solid fa-plus me-1"></i>Tạo lịch</button>
      </div>

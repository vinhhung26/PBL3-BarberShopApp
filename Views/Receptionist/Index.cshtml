@{Layout="_ReceptionistLayout";}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{--gold:#ff9d00;--gd:#cc7a00;--dark:#1a1a1a;--bg:#f0f2f5;--card:#fff;--bd:#e2e8f0;--mu:#64748b;--ok:#16a34a;--er:#dc2626;--inf:#0284c7;--r:10px;}
*{box-sizing:border-box;}
/* ─── POS GRID ─────────────────────────────────────── */
.pos-grid{display:grid;grid-template-columns:1fr 380px 250px;height:100%;overflow:hidden;}
/* ─── ZONE A ────────────────────────────────────────── */
.zA{background:var(--bg);display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--bd);}
.zA-hdr{padding:10px 14px 8px;background:var(--card);border-bottom:1px solid var(--bd);flex-shrink:0;}
.zA-body{overflow-y:auto;padding:12px 14px;flex:1;}
.pills{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;}
.pill{cursor:pointer;padding:4px 13px;border-radius:20px;font-size:12px;font-weight:600;background:var(--bg);border:1.5px solid var(--bd);color:var(--mu);transition:.15s;user-select:none;}
.pill.on{background:var(--dark);color:#fff;border-color:var(--dark);}
.srch{position:relative;max-width:260px;}
.srch i{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--mu);font-size:11px;}
.srch input{width:100%;padding:6px 10px 6px 28px;border:1.5px solid var(--bd);border-radius:18px;font-size:12px;background:var(--bg);outline:none;}
.srch input:focus{border-color:var(--gold);}
.sg{display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:8px;}
.sc{background:var(--card);border:1.5px solid var(--bd);border-radius:var(--r);padding:12px 8px 10px;cursor:pointer;text-align:center;transition:.15s;user-select:none;position:relative;}
.sc:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 4px 12px rgba(255,157,0,.15);}
.sc.on{border-color:var(--gold);background:#fffbf0;}
.sc.on::after{content:'✓';position:absolute;top:4px;right:6px;font-size:10px;font-weight:800;color:var(--gold);}
.si{width:36px;height:36px;border-radius:50%;background:#fff7ed;display:flex;align-items:center;justify-content:center;margin:0 auto 6px;font-size:14px;color:var(--gd);}
.sn{font-size:11px;font-weight:600;color:#1e293b;margin-bottom:3px;line-height:1.3;}
.sp{font-size:13px;font-weight:700;color:var(--ok);}
@@keyframes pop{0%{transform:scale(.93);opacity:0}100%{transform:scale(1);opacity:1}}
.pop{animation:pop .18s ease;}
@@keyframes sh{0%,100%{opacity:1}50%{opacity:.4}}
.sk{pointer-events:none;background:#f1f5f9;}
.sk .si,.sk .sn,.sk .sp{background:#e2e8f0;color:transparent;border-radius:4px;animation:sh 1.2s infinite;}
/* ─── ZONE B ────────────────────────────────────────── */
.zB{background:var(--card);display:flex;flex-direction:column;border-right:1px solid var(--bd);overflow:hidden;}
.zB-hdr{padding:9px 13px;border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.zB-t{font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px;}
.bsec{padding:8px 12px;border-bottom:1px solid var(--bd);flex-shrink:0;}
.lbl{font-size:10px;font-weight:700;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;}
.bsel{width:100%;padding:7px 9px;border:1.5px solid var(--bd);border-radius:7px;font-size:12px;font-weight:600;color:var(--inf);background:#f0f9ff;outline:none;cursor:pointer;}
.bi-wrap{flex:1;overflow-y:auto;padding:6px 10px;}
.bempty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#cbd5e1;gap:6px;font-size:12px;}
.bempty i{font-size:28px;}
.brow{display:flex;align-items:center;gap:6px;padding:7px;border-radius:7px;margin-bottom:3px;background:#f8fafc;border:1px solid var(--bd);}
.bri{flex:1;min-width:0;}
.rn{font-size:11px;font-weight:600;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tb{font-size:9px;padding:1px 5px;border-radius:8px;font-weight:600;display:inline-block;margin-top:1px;}
.ts{background:#fef3c7;color:#92400e;}.tp{background:#dcfce7;color:#14532d;}
.rp{font-size:11px;font-weight:700;color:#1e293b;white-space:nowrap;flex-shrink:0;}
.qb{display:flex;align-items:center;gap:3px;flex-shrink:0;}
.qbtn{width:22px;height:22px;border:1.5px solid var(--bd);border-radius:4px;background:#fff;cursor:pointer;font-size:13px;font-weight:700;color:#475569;display:flex;align-items:center;justify-content:center;transition:.15s;}
.qbtn:hover{border-color:var(--gold);color:var(--gd);}
.qv{font-size:12px;font-weight:700;min-width:16px;text-align:center;}
.dbtn{width:24px;height:24px;border:none;border-radius:4px;background:transparent;color:#94a3b8;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;transition:.15s;}
.dbtn:hover{background:#fee2e2;color:var(--er);}
.bfoot{flex-shrink:0;padding:10px 12px;border-top:2px solid var(--bd);background:#fafafa;}
.srow{display:flex;justify-content:space-between;font-size:11px;color:var(--mu);margin-bottom:2px;}
.tbox{background:var(--dark);border-radius:9px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;margin-top:7px;}
.tlbl{font-size:10px;font-weight:700;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.5px;}
.tamt{font-size:24px;font-weight:800;color:var(--gold);line-height:1;}
/* ─── ZONE C ────────────────────────────────────────── */
.zC{background:#f8fafc;display:flex;flex-direction:column;overflow:hidden;}
.zC-hdr{padding:9px 12px 7px;border-bottom:1px solid var(--bd);font-size:13px;font-weight:700;flex-shrink:0;}
.csec{padding:8px 12px;border-bottom:1px solid var(--bd);flex-shrink:0;}
.cinp{width:100%;padding:6px 9px;border:1.5px solid var(--bd);border-radius:6px;font-size:11px;margin-bottom:4px;outline:none;background:#fff;}
.cinp:focus{border-color:var(--gold);}
.cfound{background:#f0f9ff;border:1px solid #bae6fd;border-radius:6px;padding:6px 9px;font-size:11px;display:none;margin-top:3px;}
.cfound.show{display:block;}
.cfound b{color:#0c4a6e;}
.pm{padding:10px 12px;flex-shrink:0;}
.pmb{width:100%;padding:10px 12px;border:2px solid var(--bd);border-radius:8px;background:#fff;font-size:12px;font-weight:700;color:#334155;cursor:pointer;text-align:left;display:flex;align-items:center;gap:8px;margin-bottom:6px;transition:.15s;}
.pmb i{font-size:14px;width:18px;text-align:center;}
.pmb:hover{border-color:#94a3b8;background:#f1f5f9;}
.pmb.on{border-color:var(--dark);background:var(--dark);color:#fff;}
.pmb.on i{color:var(--gold);}
.pprev{margin:0 12px 8px;background:#f0fdf4;border:1.5px solid #86efac;border-radius:8px;padding:9px 11px;display:none;flex-shrink:0;}
.pprev.show{display:block;}
.pplbl{font-size:10px;font-weight:700;color:#15803d;text-transform:uppercase;letter-spacing:.5px;}
.ppamt{font-size:18px;font-weight:800;color:#14532d;}
.pcta{padding:8px 12px;flex-shrink:0;border-top:1px solid var(--bd);display:flex;gap:8px;}
/* NÚT LƯU ĐƠN (tạo mới) */
.btn-save{flex:1;padding:12px;background:#e8f5e9;color:var(--ok);border:2px solid #a5d6a7;border-radius:8px;font-size:12px;font-weight:800;cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:6px;}
.btn-save:hover:not(:disabled){background:#c8e6c9;}
.btn-save:disabled{opacity:.35;cursor:not-allowed;}
/* NÚT THANH TOÁN */
.btn-pay{flex:1.5;padding:12px;background:var(--dark);color:var(--gold);border:none;border-radius:8px;font-size:12px;font-weight:800;cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:6px;}
.btn-pay:hover:not(:disabled){background:#2d2d2d;}
.btn-pay:disabled{opacity:.35;cursor:not-allowed;}
/* ─── TOAST ─────────────────────────────────────────── */
.TC{position:fixed;top:58px;right:14px;z-index:9999;display:flex;flex-direction:column;gap:6px;pointer-events:none;}
.TM{padding:10px 14px;border-radius:9px;font-size:12px;font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.12);display:flex;align-items:center;gap:7px;min-width:220px;pointer-events:auto;}
@@keyframes tin{from{transform:translateX(28px);opacity:0}to{transform:translateX(0);opacity:1}}
@@keyframes tout{from{opacity:1}to{opacity:0;transform:translateX(28px)}}
.TM{animation:tin .22s ease;}
.TM-s{background:#f0fdf4;color:#14532d;border:1px solid #86efac;}
.TM-e{background:#fef2f2;color:#7f1d1d;border:1px solid #fca5a5;}
.TM-i{background:#eff6ff;color:#1e3a5f;border:1px solid #93c5fd;}
/* ─── MODAL ─────────────────────────────────────────── */
.OV{position:fixed;inset:0;background:rgba(0,0,0,.48);z-index:8000;display:none;align-items:center;justify-content:center;}
.OV.open{display:flex;}
.MB{background:#fff;border-radius:14px;padding:22px;width:460px;max-width:96vw;box-shadow:0 20px 60px rgba(0,0,0,.22);max-height:90vh;overflow-y:auto;}
.MBT{font-size:14px;font-weight:800;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
.MF{margin-bottom:11px;}
.MF label{font-size:10px;font-weight:700;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;}
.MF input,.MF select{width:100%;padding:8px 11px;border:1.5px solid var(--bd);border-radius:7px;font-size:12px;outline:none;font-family:inherit;}
.MF input:focus,.MF select:focus{border-color:var(--gold);}
.mhint{font-size:10px;margin-top:3px;color:var(--mu);}
.mhint.ok{color:var(--ok);}.mhint.bad{color:var(--er);}
.MA{display:flex;gap:8px;margin-top:14px;}
.bmc{flex:1;padding:9px;border:1.5px solid var(--bd);background:#fff;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;}
.bmc:hover{background:#f1f5f9;}
.bms{flex:1.5;padding:9px;border:none;background:var(--dark);color:var(--gold);border-radius:7px;font-size:12px;font-weight:800;cursor:pointer;}
.bms:hover{background:#2d2d2d;}.bms:disabled{opacity:.45;cursor:not-allowed;}
.bmd{flex:.8;padding:9px;border:1.5px solid #fca5a5;background:#fff;border-radius:7px;font-size:11px;font-weight:600;cursor:pointer;color:var(--er);}
.bmd:hover{background:#fee2e2;}
/* ─── TABS ───────────────────────────────────────────── */
.tab-pane{display:none;height:100%;}
.tab-pane.show.active{display:block;}
#tab-thungan{display:none;}
#tab-thungan.show.active{display:grid!important;}
.TSW{height:100%;overflow-y:auto;padding:16px;background:var(--bg);}
.TCARD{background:#fff;border-radius:var(--r);border:1px solid var(--bd);overflow:hidden;margin-bottom:12px;}
.TT{width:100%;border-collapse:collapse;}
.TT th{padding:8px 12px;font-size:10px;font-weight:700;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;background:#f8fafc;border-bottom:1px solid var(--bd);text-align:left;}
.TT td{padding:9px 12px;font-size:12px;border-bottom:1px solid #f1f5f9;vertical-align:middle;}
.TT tbody tr:hover td{background:#f8fafc;}
.TT tbody tr:last-child td{border-bottom:none;}
.ST{display:inline-flex;align-items:center;gap:3px;padding:3px 10px;border-radius:18px;font-size:11px;font-weight:600;}
.sw{background:#fef9c3;color:#854d0e;}.sc{background:#dbeafe;color:#1e3a8a;}
.sd{background:#dcfce7;color:#14532d;}.sx{background:#fee2e2;color:#7f1d1d;}
.spd{background:#fef3c7;color:#92400e;}.spa{background:#dcfce7;color:#14532d;}
.LR td{text-align:center;padding:28px;color:var(--mu);font-size:12px;}
.breset{background:transparent;border:1px solid var(--bd);color:var(--mu);padding:3px 9px;border-radius:5px;font-size:11px;cursor:pointer;}
.breset:hover{border-color:var(--er);color:var(--er);}
/* ─── BILL LIST QUEUE ────────────────────────────────── */
.queue-bar{background:var(--dark);padding:6px 12px;display:flex;gap:6px;overflow-x:auto;flex-shrink:0;border-bottom:2px solid var(--gold);min-height:44px;align-items:center;}
.queue-bar::-webkit-scrollbar{height:4px;}.queue-bar::-webkit-scrollbar-thumb{background:#444;border-radius:2px;}
.q-tab{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.7);padding:4px 10px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:5px;transition:.15s;flex-shrink:0;}
.q-tab:hover{background:rgba(255,255,255,.15);}
.q-tab.on{background:rgba(255,157,0,.2);border-color:var(--gold);color:var(--gold);}
.q-tab .qx{font-size:10px;color:rgba(255,255,255,.4);cursor:pointer;margin-left:2px;}
.q-tab.on .qx{color:rgba(255,157,0,.6);}
.q-tab .qx:hover{color:var(--er)!important;}
.q-new{background:rgba(255,157,0,.15);border:1px dashed var(--gold);color:var(--gold);padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;transition:.15s;flex-shrink:0;}
.q-new:hover{background:rgba(255,157,0,.25);}
.zone-bill-wrap{display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--bd);}
</style>

<div class="TC" id="TC"></div>

<!-- Modal xóa item -->
<div class="OV" id="modDel">
  <div class="MB" style="width:300px;text-align:center;">
    <div style="font-size:28px;color:var(--er);margin-bottom:8px;"><i class="fa-solid fa-triangle-exclamation"></i></div>
    <div style="font-size:14px;font-weight:700;margin-bottom:6px;">Xóa khỏi hóa đơn?</div>
    <div class="mhint bad" id="modDelMsg" style="font-size:12px;margin-bottom:14px;"></div>
    <div class="MA"><button class="bms" onclick="closeM('modDel')"><i class="fa-solid fa-arrow-left me-1"></i>Giữ lại</button><button class="bmd" id="modDelOk">Xóa</button></div>
  </div>
</div>

<!-- Modal tạo lịch hẹn -->
<div class="OV" id="modAppt">
  <div class="MB">
    <div class="MBT"><i class="fa-regular fa-calendar-plus" style="color:var(--gold);"></i>Tạo lịch hẹn mới</div>
    <div class="MF">
      <label>SĐT khách hàng *</label>
      <input id="aPhone" type="tel" placeholder="Nhập SĐT để tra cứu...">
      <div class="mhint" id="aHint"></div>
      <input type="hidden" id="aCustId">
    </div>
    <div class="MF"><label>Barber *</label><select id="aBarberId"><option value="">-- Chọn --</option></select></div>
    <div class="MF"><label>Ngày & Giờ hẹn *</label><input id="aTime" type="datetime-local"></div>
    <div class="MA"><button class="bmc" onclick="closeM('modAppt')">Hủy</button><button class="bms" id="btnApptOk" onclick="submitAppt()"><i class="fa-solid fa-check me-1"></i>Xác nhận</button></div>
  </div>
</div>

<!-- Modal đăng ký KH -->
<div class="OV" id="modNC">
  <div class="MB">
    <div class="MBT"><i class="fa-solid fa-user-plus" style="color:var(--ok);"></i>Đăng ký khách hàng mới</div>
    <div class="MF"><label>Họ và tên *</label><input id="ncName" type="text" placeholder="Nguyễn Văn A..."></div>
    <div class="MF"><label>Số điện thoại *</label><input id="ncPhone" type="tel" placeholder="09xxxxxxxx"></div>
    <div class="MF"><label>Ngày sinh</label><input id="ncDob" type="date"></div>
    <div class="MA"><button class="bmc" onclick="closeM('modNC')">Hủy</button><button class="bms" id="btnNCOk" onclick="submitNC()"><i class="fa-solid fa-check me-1"></i>Tạo khách hàng</button></div>
  </div>
</div>

<!-- Modal sửa KH -->
<div class="OV" id="modEC">
  <div class="MB">
    <div class="MBT"><i class="fa-solid fa-pen" style="color:var(--inf);"></i>Sửa thông tin khách hàng</div>
    <input type="hidden" id="ecId">
    <div class="MF"><label>Họ và tên</label><input id="ecName" type="text"></div>
    <div class="MF"><label>Số điện thoại</label><input id="ecPhone" type="tel"></div>
    <div class="MF"><label>Ngày sinh</label><input id="ecDob" type="date"></div>
    <div class="MA"><button class="bmc" onclick="closeM('modEC')">Hủy</button><button class="bms" id="btnECOk" onclick="submitEC()">Lưu thay đổi</button></div>
  </div>
</div>

<!-- Modal chi tiết hóa đơn -->
<div class="OV" id="modBD">
  <div class="MB" style="width:520px;">
    <div class="MBT"><i class="fa-solid fa-file-invoice" style="color:var(--gold);"></i>Chi tiết hóa đơn <span id="bdId" style="font-weight:400;font-size:12px;"></span></div>
    <div id="bdBody"></div>
    <div class="MA" id="bdActs"></div>
  </div>
</div>


<!-- ═══ TAB THU NGÂN ════════════════════════════════════════ -->
<div id="tab-thungan" class="tab-pane show active pos-grid">

  <!-- ZONE A: Menu -->
  <div class="zA">
    <div class="zA-hdr">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:6px;">
        <div class="pills">
          <div class="pill on" onclick="filterCat(this,'all')">Tất cả</div>
          <div class="pill" onclick="filterCat(this,'service')"><i class="fa-solid fa-scissors" style="font-size:9px;margin-right:3px;"></i>Dịch vụ</div>
          <div class="pill" onclick="filterCat(this,'product')"><i class="fa-solid fa-box" style="font-size:9px;margin-right:3px;"></i>Sản phẩm</div>
        </div>
        <div class="srch"><i class="fa-solid fa-magnifying-glass"></i><input placeholder="Tìm nhanh..." oninput="filterSearch(this.value)"></div>
      </div>
    </div>
    <div class="zA-body">
      <div class="sg" id="SG">
        <div class="sc sk"><div class="si"></div><div class="sn">...</div><div class="sp">...</div></div>
        <div class="sc sk"><div class="si"></div><div class="sn">...</div><div class="sp">...</div></div>
        <div class="sc sk"><div class="si"></div><div class="sn">...</div><div class="sp">...</div></div>
        <div class="sc sk"><div class="si"></div><div class="sn">...</div><div class="sp">...</div></div>
      </div>
    </div>
  </div>

  <!-- ZONE B: Hóa đơn với queue tabs -->
  <div class="zone-bill-wrap">
    <!-- Queue bar: danh sách đơn đang mở -->
    <div class="queue-bar" id="QB">
      <button class="q-new" onclick="newDraft()"><i class="fa-solid fa-plus me-1"></i>Đơn mới</button>
    </div>

    <div class="zB" style="flex:1;overflow:hidden;border-right:none;">
      <div class="zB-hdr">
        <div class="zB-t">
          <i class="fa-solid fa-file-invoice-dollar" style="color:var(--gold);"></i>
          Hóa đơn <span id="B_IDL" style="font-size:10px;color:var(--mu);font-weight:400;margin-left:4px;"></span>
        </div>
        <span id="B_STATUS" style="font-size:10px;color:var(--mu);"></span>
      </div>
      <div class="bsec">
        <div class="lbl"><i class="fa-solid fa-user-tie me-1"></i>Thợ thực hiện</div>
        <select class="bsel" id="B_BAR" onchange="onBarberChange()"><option value="">-- Chọn Barber --</option></select>
      </div>
      <div class="bi-wrap" id="B_ITEMS">
        <div class="bempty" id="B_EMPTY">
          <i class="fa-regular fa-file-lines"></i>
          <span>Chưa có mục nào</span>
          <span style="font-size:10px;color:#e2e8f0;">① Chọn barber → ② Click dịch vụ/SP</span>
        </div>
      </div>
      <div class="bfoot">
        <div class="srow"><span>Tạm tính (<span id="B_CNT">0</span> mục)</span><span id="B_SUB">0đ</span></div>
        <div class="tbox"><div class="tlbl">Khách phải trả</div><div class="tamt" id="B_TOT">0đ</div></div>
      </div>
    </div>
  </div>

  <!-- ZONE C: Thanh toán -->
  <div class="zC">
    <div class="zC-hdr"><i class="fa-solid fa-hand-holding-dollar me-2" style="color:var(--gold);"></i>Thanh toán</div>
    <div class="csec">
      <div class="lbl">Khách hàng (tuỳ chọn)</div>
      <input class="cinp" id="C_PHONE" type="tel" placeholder="Nhập SĐT tra cứu..." oninput="debounceCL(this.value)">
      <div class="cfound" id="C_FOUND"><b id="CF_NAME"></b><br><span id="CF_TIER" style="color:var(--mu);font-size:10px;"></span></div>
      <input type="hidden" id="C_CUSTID">
    </div>
    <div class="pm">
      <div class="lbl">Phương thức thanh toán</div>
      <button class="pmb" data-m="cash"     onclick="selPay(this)"><i class="fa-solid fa-money-bill-wave" style="color:#16a34a;"></i>Tiền mặt</button>
      <button class="pmb" data-m="transfer" onclick="selPay(this)"><i class="fa-solid fa-mobile-screen"   style="color:#0284c7;"></i>Chuyển khoản</button>
      <button class="pmb" data-m="card"     onclick="selPay(this)"><i class="fa-solid fa-credit-card"     style="color:#7c3aed;"></i>Thẻ ngân hàng</button>
    </div>
    <div class="pprev" id="C_PREV"><div class="pplbl" id="C_PLBL"></div><div class="ppamt" id="C_PAMT">0đ</div></div>
    <div class="pcta">
      <!-- LƯU ĐƠN: lưu trạng thái PENDING vào DB, reset về đơn trắng -->
      <button class="btn-save" id="BTN_SAVE" disabled onclick="saveDraft()">
        <i class="fa-solid fa-floppy-disk"></i>Lưu đơn
      </button>
      <!-- THANH TOÁN: thanh toán luôn đơn hiện tại -->
      <button class="btn-pay"  id="BTN_PAY"  disabled onclick="doPay()">
        <i class="fa-solid fa-check-circle"></i>Thanh toán
      </button>
    </div>
  </div>
</div>


<!-- ═══ TAB HÓA ĐƠN ════════════════════════════════════════ -->
<div class="tab-pane" id="tab-hoadon">
  <div class="TSW">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
      <div><h5 style="font-weight:800;margin:0;"><i class="fa-solid fa-receipt me-2" style="color:var(--gold);"></i>Danh sách hóa đơn</h5><small style="color:var(--mu);">Xem chi tiết, thanh toán hóa đơn đã lưu</small></div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <select id="BL_ST" onchange="loadBills()" style="padding:6px 10px;border:1.5px solid var(--bd);border-radius:7px;font-size:12px;outline:none;">
          <option value="">Tất cả</option><option value="PENDING">Chờ thanh toán</option><option value="PAID">Đã thanh toán</option>
        </select>
        <input type="date" id="BL_DT" onchange="loadBills()" style="padding:6px 10px;border:1.5px solid var(--bd);border-radius:7px;font-size:12px;outline:none;">

    <div class="TCARD">
      <table class="TT">
        <thead><tr><th>Giờ</th><th>Khách hàng</th><th>Barber</th><th>Trạng thái</th><th style="text-align:right;">Hành động</th></tr></thead>
        <tbody id="AP_TB"><tr class="LR"><td colspan="5"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải...</td></tr></tbody>
